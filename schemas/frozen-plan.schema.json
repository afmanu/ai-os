{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "FrozenPlan@v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "actor_id", "workspace_id", "capability_id", "capability_version", "operation_id", "policy_id", "policy_version", "source_id", "resource_ref", "expected_source_version", "patch", "patch_hash", "plan_hash", "created_at", "expires_at", "postconditions"],
  "properties": {
    "schema": { "const": "FrozenPlan@v1" },
    "plan_id": { "type": "string" },
    "actor_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "capability_id": { "const": "cap.task-record" },
    "capability_version": { "const": "0.1.0" },
    "operation_id": { "const": "task.update.execute" },
    "policy_id": { "type": "string" },
    "policy_version": { "type": "integer", "minimum": 1 },
    "source_id": { "type": "string" },
    "resource_ref": { "type": "string" },
    "expected_source_version": { "type": "integer", "minimum": 0 },
    "patch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path", "value"],
        "properties": {
          "op": { "enum": ["add", "replace"] },
          "path": { "enum": ["/status", "/blocker", "/next_action", "/notes/-"] },
          "value": {}
        }
      }
    },
    "patch_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "plan_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "postconditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
