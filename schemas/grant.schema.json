{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "MutationGrant@v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grant_id", "plan_id", "plan_hash", "approver_actor_id", "executor_actor_id", "workspace_id", "source_id", "resource_ref", "capability_id", "capability_version", "operation_id", "policy_id", "policy_version", "issued_at", "expires_at", "max_uses", "use_count"],
  "properties": {
    "schema": { "const": "MutationGrant@v1" },
    "grant_id": { "type": "string" },
    "plan_id": { "type": "string" },
    "plan_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "approver_actor_id": { "type": "string" },
    "executor_actor_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "source_id": { "type": "string" },
    "resource_ref": { "type": "string" },
    "capability_id": { "type": "string" },
    "capability_version": { "type": "string" },
    "operation_id": { "type": "string" },
    "policy_id": { "type": "string" },
    "policy_version": { "type": "integer" },
    "issued_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "max_uses": { "const": 1 },
    "use_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "consumed_at": { "type": ["string", "null"] },
    "execution_id": { "type": ["string", "null"] }
  }
}
