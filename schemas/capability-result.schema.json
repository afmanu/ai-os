{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "CapabilityResult@v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "execution_id",
    "workspace_id",
    "resource_ref",
    "capability_id",
    "capability_version",
    "operation_id",
    "outcome",
    "verified",
    "source_version",
    "artifact_ref",
    "output",
    "verification",
    "evidence_refs",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "CapabilityResult@v1" },
    "result_id": { "type": "string", "minLength": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "resource_ref": { "type": "string", "minLength": 1 },
    "capability_id": { "type": "string", "pattern": "^cap\\.[a-z][a-z0-9-]*$" },
    "capability_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "operation_id": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["SUCCEEDED", "VERIFICATION_FAILED"] },
    "verified": { "type": "boolean" },
    "source_version": { "type": "integer", "minimum": 1 },
    "artifact_ref": { "type": ["string", "null"] },
    "output": { "type": "object" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "failures", "checks"],
      "properties": {
        "ok": { "type": "boolean" },
        "failures": { "type": "array", "items": { "type": "string" } },
        "checks": { "type": "object" }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
