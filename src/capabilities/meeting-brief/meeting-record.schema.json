{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "MeetingRecord@v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "meeting_id", "workspace_id", "title", "held_at", "participants", "statements", "decisions", "commitments", "open_questions", "conflicts", "provenance_refs", "version", "classification"],
  "properties": {
    "schema": { "const": "MeetingRecord@v1" },
    "meeting_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "title": { "type": "string" },
    "held_at": { "type": "string" },
    "participants": { "type": "array", "items": { "$ref": "#/definitions/participant" } },
    "statements": { "type": "array", "items": { "$ref": "#/definitions/statement" } },
    "decisions": { "type": "array", "items": { "$ref": "#/definitions/record" } },
    "commitments": { "type": "array", "items": { "$ref": "#/definitions/commitment" } },
    "open_questions": { "type": "array", "items": { "$ref": "#/definitions/record" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/definitions/record" } },
    "provenance_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "version": { "type": "integer", "minimum": 1 },
    "classification": { "const": "synthetic" }
  },
  "definitions": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_id", "display_name", "evidence_ref"],
      "properties": {
        "participant_id": { "type": "string" },
        "display_name": { "type": "string" },
        "evidence_ref": { "type": "string" }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement_id", "speaker_ref", "statement_type", "text", "evidence_ref"],
      "properties": {
        "statement_id": { "type": "string" },
        "speaker_ref": { "type": "string" },
        "statement_type": { "enum": ["observation", "suggestion", "question"] },
        "text": { "type": "string" },
        "evidence_ref": { "type": "string" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "text", "evidence_ref"],
      "properties": {
        "record_id": { "type": "string" },
        "text": { "type": "string" },
        "evidence_ref": { "type": "string" }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "text", "owner_ref", "due_at", "evidence_ref"],
      "properties": {
        "record_id": { "type": "string" },
        "text": { "type": "string" },
        "owner_ref": { "type": ["string", "null"] },
        "due_at": { "type": ["string", "null"] },
        "evidence_ref": { "type": "string" }
      }
    }
  }
}
