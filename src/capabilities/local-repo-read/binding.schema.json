{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "LocalRepositoryBinding@v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "repositories"],
  "properties": {
    "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id", "source_id", "root", "documents", "max_file_bytes", "history_limit", "stale_after_days"],
        "properties": {
          "repository_id": { "type": "string", "pattern": "^REPO-[A-Z0-9-]+$" },
          "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
          "root": { "type": "string", "minLength": 1 },
          "documents": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "max_file_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "history_limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "stale_after_days": { "type": "integer", "minimum": 1, "maximum": 3650 }
        }
      }
    }
  }
}
